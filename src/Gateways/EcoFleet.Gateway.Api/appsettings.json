{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "shipment-route": {
        "ClusterId": "shipment-cluster",
        "RateLimiterPolicy": "fixed-window",
        "CorsPolicy": "GatewayCorsPolicy",
        "Match": {
          "Path": "/api/v1/shipments/{**catch-all}"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "fixed-window",
        "CorsPolicy": "GatewayCorsPolicy",
        "Match": {
          "Path": "/api/v1/identity/{**catch-all}"
        }
      },
      "company-route": {
        "ClusterId": "company-cluster",
        "RateLimiterPolicy": "fixed-window",
        "CorsPolicy": "GatewayCorsPolicy",
        "Match": {
          "Path": "/api/v1/companies/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "shipment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://shipment-api"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-api"
          }
        }
      },
      "company-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://company-api"
          }
        }
      }
    }
  }
}